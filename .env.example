# App / Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Environment: DEV | PROD
PROJ_STATUS=DEV

# Database
# SQLite file path for DEV (defaults to data/m.db)
SQLITE_PATH=data/m.db

# Turso/libSQL for PROD
MANDAOZI_TURSO_DATABASE_URL=
MANDAOZI_TURSO_AUTH_TOKEN=

# OTP provider: console | textbee | whatsapp-meta
OTP_PROVIDER=console

# TextBee SMS (when OTP_PROVIDER=textbee)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# WhatsApp Meta Cloud API (when OTP_PROVIDER=whatsapp-meta)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=en
# Legacy fallback
# WHATSAPP_PROVIDER=meta
MANDAOZI_TURSO_AUTH_TOKEN=
MANDAOZI_TURSO_DATABASE_URL=